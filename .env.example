NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
NEXT_PUBLIC_SITE_URL=https://atelier-dekant.vercel.app

# Optional: "Fill from screenshot" in the admin (reads notes/accords/when-to-wear from an image).
# Without a key the button is hidden and everything else works normally.
# ANTHROPIC_API_KEY=sk-ant-...
# SCENT_AI_MODEL=claude-opus-5-5

# Optional: shopping assistant chat (uses the same ANTHROPIC_API_KEY).
# CHAT_AI_MODEL=claude-opus-5-5
# Site-wide daily message cap (cost protection); per visitor: 20 messages per 10 minutes
# CHAT_DAILY_LIMIT=1000

# Order emails (received / confirmed / shipped / cancelled) via https://resend.com.
# The sending domain must be verified in Resend. Without these, emails are skipped.
# RESEND_API_KEY=re_...
# EMAIL_FROM="Atelier Dekant <orders@your-domain.com>"
# Receives a notification for every new order; customer replies go here too.
# ADMIN_NOTIFY_EMAIL=owner@example.com

# Seller details (required by Serbian consumer law): shown in the footer, terms and privacy policy.
# NEXT_PUBLIC_COMPANY_NAME="Full Name PR Atelier Dekant Beograd"
# NEXT_PUBLIC_COMPANY_ADDRESS="Street 1, 11000 Beograd"
# NEXT_PUBLIC_COMPANY_PIB=123456789
# NEXT_PUBLIC_COMPANY_MB=12345678
# Contact email and phone shown on the site (footer, contact page, legal pages)
# NEXT_PUBLIC_COMPANY_EMAIL=you@example.com
# NEXT_PUBLIC_COMPANY_PHONE="+381 60 000 0000"

# IPS QR instant payment (NBS standard): the customer gets a QR code after checkout and the
# transfer details by email. Cash on delivery stays available. Without these, no QR is shown.
# Account number in any format; the check digits are validated.
# IPS_ACCOUNT_NUMBER=160-0000000123456-78
# Payee name and city as registered with the bank (max 70 characters)
# IPS_PAYEE_NAME="Atelier Dekant, Beograd"
# Payment code (default 289)
# IPS_PAYMENT_CODE=289

# Analytics (loaded only after the visitor accepts cookies; without IDs there's no cookie banner).
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_META_PIXEL_ID=1234567890
